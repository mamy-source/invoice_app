# Server
PORT=9000
NODE_ENV=development
DATABASE_URL= "mysql://miekely:Admin123%23@localhost:3306/invoice"

#SMTP
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USERNAME="SMTP_USERNAME"
SMTP_PASSWORD="SMTP_PASSWORD"
